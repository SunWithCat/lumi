# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android build cache
/android/.gradle/
/android/.kotlin/
/android/app/.cxx/
/android/local.properties

# API 配置 (包含敏感信息)


# Cubism SDK (太大，不上传，需要用户自行下载)
/android/app/src/main/cpp/CubismSdkForNative/

# Live2D 模型资源 (版权原因，不上传)
/android/app/src/main/assets/**/*
!/android/app/src/main/assets/*.frag
!/android/app/src/main/assets/*.vert

# 排除本地生成的数据库 (防止隐私泄露)
*.db
*.db-journal
*.sqlite

# 排除用户本地生成的配置文件
**/api_config.local.dart


# 文档 (仅供本地学习使用)
/docs/
.kiro/
.vscode/
.gemini/

# 签名
key.properties
*.jks
*.keystore
